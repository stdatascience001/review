# ---- Server ----
NODE_ENV=development
PORT=4000
# Public URL of this API (used to build the Google OAuth callback URL)
API_URL=http://localhost:4000
# Frontend URL (used in email links and post-login redirects)
APP_URL=http://localhost:3000
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0

# ---- Database ----
DATABASE_URL=postgresql://wrtm_owner:CHANGE_ME@localhost:5432/wrtm_dev?schema=public
# Optional. Defaults to DATABASE_URL with the database name replaced by "wrtm_test".
# The test suite TRUNCATES every table, so it refuses database names without "test".
# TEST_DATABASE_URL=

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# Require a verified email before accessing workspace (website/project/task) APIs
REQUIRE_EMAIL_VERIFICATION=true
# Cookie settings (COOKIE_SECURE must be true in production / HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${API_URL}/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Email (SMTP). If SMTP_HOST is empty in development, emails are written to .mail-outbox/ ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Website Review <no-reply@example.com>"

# Internal address for lead/admin notifications (optional)
LEAD_NOTIFY_TO=

# ---- Websites & team ----
# Public URL of the review widget loader in generated embed snippets (default: ${API_URL}/widget.js).
# If it is on another origin (CDN), the snippet also gets data-api-url so the widget finds this API.
EMBED_SCRIPT_URL=
# Built widget files served at /widget.js and /widget-app/* (default: ../widget/dist)
WIDGET_DIST_DIR=
# Uploaded screenshots/files (default: backend/storage/uploads); served via signed, expiring URLs
UPLOAD_DIR=
MAX_UPLOAD_MB=10
INVITATION_TTL_DAYS=7
# Optional: serve the built dashboard (frontend/dist) from this server = single-origin deployment
FRONTEND_DIST_DIR=
# Domain verification fetches customer sites; private/loopback addresses are refused unless true (dev only!)
ALLOW_PRIVATE_NETWORK_FETCH=false

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
