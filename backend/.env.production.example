# ── Production configuration ─────────────────────────────────────────────
# Copy to backend/.env.production, fill in every CHANGE_ME, and keep it out of git
# (it is ignored). In containers/PaaS, set these as environment variables instead.
# The server refuses to start if security-critical values are missing or unsafe.

NODE_ENV=production
PORT=4000
# Behind Caddy/Nginx/a load balancer: number of proxy hops to trust (client IP for rate limits/audit log)
TRUST_PROXY=1

# Public URLs (https required). Single-origin deployment: all three are the same domain.
API_URL=https://review.example.com
APP_URL=https://review.example.com
CORS_ORIGINS=https://review.example.com
# Serve the built dashboard from Node (set by the Docker image; for bare metal point at frontend/dist)
FRONTEND_DIST_DIR=/opt/wrtm/frontend/dist
WIDGET_DIST_DIR=/opt/wrtm/widget/dist

# Database — the app connects with a LEAST-PRIVILEGE role (rows only, no DDL; see docs/DATABASE.md).
DATABASE_URL=postgresql://wrtm_app:CHANGE_ME@db:5432/wrtm?schema=public&connection_limit=10
# Migrations run as the schema OWNER (used by RUN_MIGRATIONS=true in the Docker image).
MIGRATION_DATABASE_URL=postgresql://wrtm_owner:CHANGE_ME@db:5432/wrtm?schema=public

# Auth — generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_RANDOM_CHARACTERS
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true
COOKIE_SECURE=true
# Only if the dashboard and API are on different subdomains (e.g. .example.com); empty = host-only cookies
COOKIE_DOMAIN=

# Google sign-in (optional). Authorized redirect URI: https://review.example.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (required in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM="Website Review <no-reply@review.example.com>"
LEAD_NOTIFY_TO=

# Widget & uploads
EMBED_SCRIPT_URL=
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
INVITATION_TTL_DAYS=7
ALLOW_PRIVATE_NETWORK_FETCH=false

# Rate limiting (per client IP)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_MAX=20

# Logging: info in production (JSON lines on stdout; ship them to your log platform)
LOG_LEVEL=info

# One-time: create the platform super admin (then remove these)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=CHANGE_ME_long_password
