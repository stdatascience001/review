{
  "name": "@wrtm/widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable website review widget: a tiny loader (widget.js) plus a lazily loaded React panel rendered in Shadow DOM.",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.6"
  }
}
